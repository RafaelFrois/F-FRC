# Copie para .env e preencha. Nunca versione o .env.
# Mantenha o mesmo nome de banco usado hoje em produção (a URI atual não define
# nenhum, então o Mongo usa o banco padrão "test"). Trocar o nome aponta para um banco vazio.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
# Segredo longo e aleatório. Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_strong_secret
TBA_KEY=your_tba_key
FRC_SEASON_YEAR=2026
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Porta da API local (npm run dev:api). O Vite faz proxy de /api para ela.
API_PORT=3000
# Opcional: MongoDB descartável para os testes. Sem ele, os testes sobem um MongoDB em memória.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017
